# Copy this file to `.env` (same directory) and fill in your own values.
# `.env` is git-ignored - never commit real keys.
#
#   cp .env.example .env
#
# The bot refuses to start (require_secrets) when GROQ_API_KEY,
# TELEGRAM_TOKEN or SERPER_API_KEY are missing.

# Groq - LLM reasoning / semantic parsing (required)
GROQ_API_KEY=your-groq-api-key

# Telegram bot token from @BotFather (required)
TELEGRAM_TOKEN=your-telegram-bot-token

# Serper.dev - Google search API used by the RAG web-search fallback (required)
SERPER_API_KEY=your-serper-api-key

# Google Gemini - used by auxiliary tooling only (optional)
GEMINI_API_KEY=your-gemini-api-key

# Optional path overrides (defaults shown, relative to the project root)
# NOVACORTEX_DATA_DIR=data
# NOVACORTEX_DB_PATH=novacortex_v12.db
# NOVACORTEX_LOG_FILE=logs/novacortex.log
